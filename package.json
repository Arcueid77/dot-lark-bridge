{
  "name": "dot-lark-bridge",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Owner-only Feishu bot private-text bridge to an existing dot through MCP Events",
  "license": "MIT",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage test/*.test.js",
    "simulate": "node scripts/simulate.js",
    "status": "node --env-file-if-exists=.env scripts/status.js",
    "setup": "node scripts/setup.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "handoff": "node scripts/package-handoff.js",
    "serve": "node --env-file-if-exists=.env scripts/run-service.js"
  },
  "dependencies": {
    "@dot-bridge/core": "file:vendor/dot-bridge-core-0.4.0.tgz",
    "@larksuiteoapi/node-sdk": "1.74.0"
  },
  "exports": {
    "./adapter": "./src/tunnel-adapter.js",
    "./config": "./src/config.js",
    "./server": "./src/server.js",
    "./runtime/live": "./scripts/run-tunnel-live.js",
    "./runtime/readiness": "./scripts/run-tunnel-readiness.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "scripts/",
    "vendor/",
    "docs/",
    "plugin/",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.en.md"
  ]
}
